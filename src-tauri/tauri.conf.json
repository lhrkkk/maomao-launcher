{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaoMao Token",
  "version": "1.2.2",
  "identifier": "world.binaryworld.maomao.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "猫猫 Token",
        "width": 460,
        "height": 780,
        "minWidth": 460,
        "minHeight": 780,
        "maxWidth": 460,
        "maxHeight": 780,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
