{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaoMao Token",
  "version": "1.4.3",
  "identifier": "world.binaryworld.maomao.launcher",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "maomao"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3NjdBNkUxM0JFMjYzNDkKUldSSlkrSTc0YVpueCtQS0VKdHlpNlpFczdzempTcGlTR3RvOE9NSm5BdjFjUCs2cFBBcjN1UGsK",
      "endpoints": [
        "https://binaryworld.world/latest.json"
      ]
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "猫猫 Token",
        "width": 460,
        "height": 780,
        "minWidth": 460,
        "minHeight": 780,
        "maxWidth": 460,
        "maxHeight": 780,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' ipc: http://ipc.localhost https://challenges.cloudflare.com; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/zh-Hans.lproj/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
